# FOSSA connection settings for download_sbom.sh
#
# This file is sourced by download_sbom.sh. It intentionally contains NO
# secrets — the API key is read from the environment (see FOSSA_API_KEY below)
# so it can be safely committed.

# Base URL of the FOSSA API server.
#   - FOSSA SaaS:   https://app.fossa.com
#   - On-prem:      https://fossa.your-company.com
FOSSA_ENDPOINT="https://app.fossa.com"

# The FOSSA project to pull the SBOM for.
# Accepts either the project locator (e.g. "custom+123/my-project") or the
# VCS URL. Leave empty to let the FOSSA CLI infer it from the git 'origin'
# remote of the current directory.
FOSSA_PROJECT="Helion System"

# The revision to report on. Leave empty to use the current git HEAD.
FOSSA_REVISION=""

# Output file for the downloaded SPDX-JSON SBOM.
SBOM_OUTPUT="inputs/sbom_new.json"

# Report format. Keep as spdx-json for the SPDX 2.3 JSON deliverable expected
# by sbom_to_excel.py. (Other valid values: spdx, cyclonedx-json, json, ...)
SBOM_FORMAT="spdx-json"

# Seconds to wait for FOSSA to finish building the report.
FOSSA_TIMEOUT="600"

# ---------------------------------------------------------------------------
# Release-group aggregate export (used by download_release_sbom.py)
# ---------------------------------------------------------------------------
# The FOSSA CLI cannot export the *aggregated* SBOM of a release group — only
# per-project reports. download_release_sbom.py fills that gap: it resolves the
# release, lists its projects and merges every project's SPDX-JSON into one
# aggregate SPDX 2.3 document.
#
# Identify the release either by title (human-readable) ...
FOSSA_RELEASE_GROUP_TITLE=""
FOSSA_RELEASE_TITLE=""
# ... or, if you already know them, by numeric ids (these take precedence and
# skip the title lookup):
FOSSA_RELEASE_GROUP_ID="561"
FOSSA_RELEASE_ID="67573"

# Output file for the aggregated release SBOM.
RELEASE_SBOM_OUTPUT="inputs/sbom_new.json"

# Dependency scope for the aggregate:
#   true  → keep only each project's DIRECT dependencies (default)
#   false → keep the full graph (direct + transitive)
# Override per-run with --direct-only / --all-deps.
DIRECT_ONLY="true"

# Drop test-only packages from the aggregate:
#   true  → remove test dependencies/artefacts (default)
#   false → keep them
# Override per-run with --exclude-test / --include-test.
EXCLUDE_TEST="true"
# Optional extra comma-separated regex patterns (matched, case-insensitive,
# against each package's name + purl) to treat as test packages, in addition to
# the built-in list (testify, testcontainers, junit, mockito, jest, ...).
TEST_PATTERNS=""

# API key — DO NOT hard-code it here. Provide it via the environment:
#     export FOSSA_API_KEY="xxxxxxxx"
# or drop it into a git-ignored file named ".fossa.secret" (KEY on a single
# line, or "FOSSA_API_KEY=..."), which download_sbom.sh will load automatically.

# ---------------------------------------------------------------------------
# End-of-support enrichment (used by enrich_eol.py)
# ---------------------------------------------------------------------------
# Local cache of resolved end-of-support dates (keyed by package SPDXID) that
# sbom_to_excel.py reads via --eol-data. Regenerated by enrich_eol.py.
EOL_DATA_OUTPUT="outputs/eol_data.json"

# Advisory human-readable report: resolved matches plus suspected false
# positives / false negatives for manual review.
EOL_REPORT_OUTPUT="outputs/eol_report.md"

# Curated per-library end-of-support overrides (committed, hand-maintained).
# Pins a fixed date for a library by name (case-insensitive, any version),
# winning over the value computed from endoflife.date. Applied by enrich_eol.py.
EOL_OVERRIDES="config/eol_overrides.json"

# ---------------------------------------------------------------------------
# OSS dependencies deliverable (used by sbom_to_oss_dependencies.py)
# ---------------------------------------------------------------------------
# Curated SPDX license overrides (committed, hand-maintained, source-verified).
# Pins a license for external binaries FOSSA can't resolve (nginx, PostgreSQL,
# MongoDB, FFmpeg, ...) by package name, winning over FOSSA's value.
OSS_LICENSE_OVERRIDES="config/license_overrides.json"
# Curated first-party component aliases (committed, hand-maintained,
# source-verified). Maps alternate names of the SAME internal component (e.g.
# the Maven artifact "tl4-app-external") to a single canonical "hel-*" name so
# both representations collapse to one row. Keyed by the short artifact name
# (last segment after ':' or '/'), case-insensitive. Used by sbom_to_excel.py
# and sbom_to_oss_dependencies.py.
OSS_COMPONENT_ALIASES="config/component_aliases.json"
